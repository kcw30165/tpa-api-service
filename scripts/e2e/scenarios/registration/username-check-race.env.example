# Template for the registration/username-check-race e2e scenario.
#
# Copy this file to a LOCAL, UNTRACKED file (e.g. username-check-race.env, already
# covered by the same gitignore rules as other local .env files in this repo) and
# fill in real values there. NEVER commit the filled-in file and NEVER paste real
# member identity, DOB, contact, OTP codes, or passwords into chat or into this
# repository. Values below are placeholders only.
#
# Required server-side precondition (confirmed): run the api-service locally with
# SPRING_PROFILES_ACTIVE=local so pre-start-challenge (captcha) is disabled; this
# scenario does not solve a captcha.

export E2E_SCENARIO_PACK=registration
export E2E_SCENARIO_ID=username-check-race
export E2E_ALLOW_MUTATIONS=true
export E2E_ALLOW_EXTERNAL_EFFECTS=true

export BFF_BASE_URL=http://localhost:8888
export REGISTRATION_E2E_ORIGIN=http://localhost:4200

# The SAME candidate username both flow A and flow B will attempt at
# /username/check. It must be unregistered before this scenario starts.
export REGISTRATION_RACE_USERNAME=CHANGE_ME

# Flow A -- the member expected to WIN the race (completes first).
export REGISTRATION_RACE_A_IDENTITY_TYPE=CHANGE_ME      # e.g. GPFS, GPN, STAFF_NO, ID
export REGISTRATION_RACE_A_IDENTITY_VALUE=CHANGE_ME
export REGISTRATION_RACE_A_DATE_OF_BIRTH=CHANGE_ME       # format dd/MM/yyyy
export REGISTRATION_RACE_A_EMAIL=CHANGE_ME                # set exactly one of EMAIL / MOBILE
export REGISTRATION_RACE_A_MOBILE=
export REGISTRATION_RACE_A_PASSWORD=CHANGE_ME
# Fill in AFTER /start has been called and the real OTP has been delivered:
export REGISTRATION_RACE_A_OTP_CODE=

# Flow B -- the member expected to LOSE the race (completes second, same username).
export REGISTRATION_RACE_B_IDENTITY_TYPE=CHANGE_ME
export REGISTRATION_RACE_B_IDENTITY_VALUE=CHANGE_ME
export REGISTRATION_RACE_B_DATE_OF_BIRTH=CHANGE_ME
export REGISTRATION_RACE_B_EMAIL=CHANGE_ME
export REGISTRATION_RACE_B_MOBILE=
export REGISTRATION_RACE_B_PASSWORD=CHANGE_ME
export REGISTRATION_RACE_B_OTP_CODE=
