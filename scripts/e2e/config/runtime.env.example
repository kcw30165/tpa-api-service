BFF_BASE_URL=http://localhost:8080
E2E_ENVIRONMENT=local
E2E_SCENARIO_PACK=platform
E2E_SCENARIO_ID=readiness
E2E_BOOTSTRAP_MODE=anonymous
E2E_CONNECT_TIMEOUT_SECONDS=5
E2E_REQUEST_TIMEOUT_SECONDS=20
E2E_TLS_VERIFY=true
ACCEPT_LANGUAGE=en
REQUEST_ID_PREFIX=bff-e2e
# Sensitive values must be supplied at runtime and never committed:
# PORTAL_SESSION_COOKIE_VALUE=
# AUTH_FLOW_COOKIE_VALUE=
# XSRF_TOKEN=
# ACCOUNT_REF=
