        "validationRules": [
          {
            "id": "address.atLeastOneRequired",
            "type": "groupRequirement",
            "severity": "error",
            "when": {
              "operator": "allGroupsEmpty",
              "groups": [
                {
                  "id": "residentialAddress",
                  "existsWhen": {
                    "field": "residentialAddressLine1",
                    "operator": "notBlank"
                  }
                },
                {
                  "id": "mailingAddress",
                  "existsWhen": {
                    "field": "mailingAddressLine1",
                    "operator": "notBlank"
                  }
                }
              ]
            },
            "then": {
              "operator": "fail",
              "targets": [
                "residentialAddressLine1",
                "mailingAddressLine1"
              ]
            },
            "code": "personalInformation.address.atLeastOneRequired",
            "message": "Please input a residential address or correspondence address."
          },
          {
            "id": "residentialAddress.completeWhenStarted",
            "type": "conditionalRequired",
            "severity": "error",
            "when": {
              "operator": "notBlank",
              "field": "residentialAddressLine1"
            },
            "then": {
              "operator": "allRequired",
              "fields": [
                "residentialAddressLine1",
                "residentialCountry"
              ],
              "targets": [
                "residentialAddressLine1",
                "residentialCountry"
              ]
            },
            "code": "personalInformation.residentialAddress.incomplete",
            "message": "Please input a residential address."
          },
          {
            "id": "mailingAddress.completeWhenStarted",
            "type": "conditionalRequired",
            "severity": "error",
            "when": {
              "operator": "notBlank",
              "field": "mailingAddressLine1"
            },
            "then": {
              "operator": "allRequired",
              "fields": [
                "mailingAddressLine1",
                "mailingCountry"
              ],
              "targets": [
                "mailingAddressLine1",
                "mailingCountry"
              ]
            },
            "code": "personalInformation.mailingAddress.incomplete",
            "message": "Please input a correspondence address."
          },
          {
            "id": "businessPhone.requiredWhenExtensionPresent",
            "type": "conditionalRequired",
            "severity": "error",
            "when": {
              "operator": "notBlank",
              "field": "hongKongBusinessPhoneExtension"
            },
            "then": {
              "operator": "required",
              "field": "hongKongBusinessPhone",
              "targets": [
                "hongKongBusinessPhone"
              ]
            },
            "code": "personalInformation.businessPhone.requiredWhenExtensionPresent",
            "message": "Please input a valid Hong Kong Business Phone Number."
          },
          {
            "id": "overseasCountryCode.requiredWhenPhonePresent",
            "type": "conditionalRequired",
            "severity": "error",
            "when": {
              "operator": "notBlank",
              "field": "overseasPhoneNumber"
            },
            "then": {
              "operator": "required",
              "field": "overseasCountryCode",
              "targets": [
                "overseasCountryCode"
              ]
            },
            "code": "personalInformation.overseasCountryCode.requiredWhenPhonePresent",
            "message": "Please input a valid Country Code."
          },
          {
            "id": "overseasPhone.requiredWhenCodePresent",
            "type": "conditionalRequired",
            "severity": "error",
            "when": {
              "operator": "any",
              "conditions": [
                {
                  "field": "overseasCountryCode",
                  "operator": "notBlank"
                },
                {
                  "field": "overseasAreaCode",
                  "operator": "notBlank"
                }
              ]
            },
            "then": {
              "operator": "required",
              "field": "overseasPhoneNumber",
              "targets": [
                "overseasPhoneNumber"
              ]
            },
            "code": "personalInformation.overseasPhoneNumber.requiredWhenCodePresent",
            "message": "Please input a valid Overseas Phone Number."
          },
          {
            "id": "aeoiReminder.whenResidentialCountryChanged",
            "type": "conditionalWarning",
            "severity": "warning",
            "when": {
              "operator": "changed",
              "field": "residentialCountry",
              "compareWith": "originalValue"
            },
            "then": {
              "operator": "showMessage",
              "targets": [
                "residentialCountry"
              ]
            },
            "code": "personalInformation.aeoiReminder",
            "message": "Please remember to submit your AEOI Self-Certificate by clicking Self Certification for Tax Residency function."
          }
        ],
        "confirmation": {
