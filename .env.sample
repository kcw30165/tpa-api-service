SERVER_PORT=8888

APIM_BASEURL=https://traffic-sitk8apim.bcthk.info
APIM_TIMEOUTMILLISECONDS=10000
APIM_ENCRYPTION_ENABLED=true
APIM_CERTIFICATE_PATH=/api/wssupport/v1/encryption/certificate
APIM_API_KEY=
APIM_PRIVATE_KEY_PEM=
APIM_PUBLIC_KEY_PEM=

APIM_CLIENT_ID=
APIM_CLIENT_SECRET=
APIM_CLIENT_AUTH_METHOD=client_secret_post
APIM_CLIENT_SCOPE=
APIM_TOKEN_URI=https://oauth-sitk8apim.bcthk.info/api/oauth/token

# Use Base64 for at least 32 random bytes; keep identical on all replicas. Never commit a value.
PASSWORD_VALIDATION_RATE_LIMIT_SECRET=
PASSWORD_VALIDATION_RATE_LIMIT_MAX_ATTEMPTS=10
PASSWORD_VALIDATION_RATE_LIMIT_WINDOW_SECONDS=60
PASSWORD_VALIDATION_GRANT_TTL_SECONDS=300
